# ============================================================
# food-map-journal 環境變數範例
# 複製成 .env 後填入實際值：  cp .env.example .env
# ============================================================

# ---- 共用 ----
# development / staging / production
DJANGO_ENV=development

# ---- Backend (Django) ----
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# 前端來源（CORS / CSRF），逗號分隔
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (PostgreSQL) ----
# 這三個給 postgres 容器與 Docker 內的 backend 共用。
POSTGRES_DB=foodmap
POSTGRES_USER=foodmap
POSTGRES_PASSWORD=foodmap
# 本機（非 Docker）開發：不要設 POSTGRES_HOST，後端會自動降級成 SQLite，最方便。
# Docker Compose 會自動帶入 POSTGRES_HOST=db / POSTGRES_PORT=5432。
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# 也可直接指定完整連線字串（優先於上面 POSTGRES_*）
# DATABASE_URL=postgres://foodmap:foodmap@db:5432/foodmap

# ---- Redis（預留給未來 Channels 即時同步） ----
REDIS_URL=redis://redis:6379/0

# ---- 版本資訊（選用，給 /healthz 顯示）----
# 留空則用 backend/config/version.py 內的預設值；CI/CD 可在部署時注入。
# APP_VERSION=0.2.0
# APP_RELEASE_DATE=2026-06-10
# APP_GIT_SHA=

# ---- Google 登入（選用）----
# 在 Google Cloud Console 建立「OAuth 2.0 用戶端 ID（網頁應用程式）」：
#   - 已授權的 JavaScript 來源： http://localhost:5173
# 前後端要用「同一組」Web Client ID（後端驗證 token 的 audience 必須相符）。
# 兩者皆留空 → 不啟用 Google 登入（登入頁不顯示 Google 按鈕，不影響 email 登入）。
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ---- Frontend (Vite) ----
# 後端 API 位置（預設 backend 對外 8080，避免與本機其他服務衝突）
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Google Maps JS API 金鑰：留空則自動降級為 Leaflet + OpenStreetMap
VITE_GOOGLE_MAPS_API_KEY=
